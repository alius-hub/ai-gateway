AI_GATEWAY_ENV=dev
AI_GATEWAY_DEBUG=true
AI_GATEWAY_APP_PORT=8001
AI_GATEWAY_DATABASE_URL=postgresql+psycopg://dev_user:Dev2026!@localhost:5432/ai_gateway
AI_GATEWAY_REDIS_URL=redis://:Dev2026!@localhost:6379/0
AI_GATEWAY_JWT_SECRET_KEY=change-me
# Generate a stable key once with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_GATEWAY_PROVIDER_ENCRYPTION_KEY=
AI_GATEWAY_ALLOWED_ORIGINS=["http://localhost:5173"]
# RustFS S3 API endpoint (NOT the :9001 console URL); leave disabled until configured.
AI_GATEWAY_LOG_ARCHIVE_ENABLED=false
AI_GATEWAY_LOG_ARCHIVE_ENDPOINT=http://192.168.0.109:9000
AI_GATEWAY_LOG_ARCHIVE_BUCKET=gateway-call-logs
AI_GATEWAY_LOG_ARCHIVE_ACCESS_KEY=
AI_GATEWAY_LOG_ARCHIVE_SECRET_KEY=
AI_GATEWAY_LOG_ARCHIVE_REGION=us-east-1
AI_GATEWAY_LOG_ARCHIVE_SPOOL_DIR=./data/call-archives
# Optional extra restriction in "mirror_images" mode; [] permits any non-blocked image host.
AI_GATEWAY_LOG_ARCHIVE_IMAGE_HOSTS=[]
